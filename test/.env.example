# ===========================================
# db0 Test Environment Variables
# ===========================================
# Copy this file to .env and fill in values
# Run: cp test/.env.example test/.env
# ===========================================

# ----- Docker Databases -----
# Start with: docker compose -f docker-compose.test.yml up -d

# PostgreSQL (port 15432)
POSTGRESQL_URL="postgres://postgres:postgres@localhost:15432/test"

# MySQL (port 13306)
MYSQL_URL="mysql://root:root@localhost:13306/test"

# MariaDB (port 13307)
MARIADB_URL="mysql://root:root@localhost:13307/test"
MARIADB_HOST="localhost"
MARIADB_PORT="13307"
MARIADB_USER="root"
MARIADB_PASSWORD="root"
MARIADB_DATABASE="test"

# MSSQL (port 11433)
MSSQL_URL="mssql://localhost:11433"
MSSQL_HOST="localhost"
MSSQL_PORT="11433"
MSSQL_USER="sa"
MSSQL_PASSWORD="Test@12345"
MSSQL_DATABASE="master"

# ----- Neon Local Proxy -----
# The neon-proxy Docker service provides local @neondatabase/serverless testing
# Uses the postgres container via the proxy on port 4444
NEON_HTTP_URL="postgres://postgres:postgres@localhost:4444/test"
NEON_WS_URL="postgres://postgres:postgres@localhost:4444/test"

# ----- Cloud Services (Optional) -----
# For testing against real cloud databases

# Neon Cloud (get from https://console.neon.tech)
# NEON_DATABASE_URL="postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# NEON_URL="postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# PlanetScale (get from https://planetscale.com)
# PLANETSCALE_URL="mysql://user:pass@aws.connect.psdb.cloud/dbname?ssl={\"rejectUnauthorized\":true}"

# Cloudflare D1 HTTP (get from https://dash.cloudflare.com)
# CF_ACCOUNT_ID="your-account-id"
# D1_DATABASE_ID="your-database-id"
# CF_API_TOKEN="your-api-token"

# Turso (get from https://turso.tech)
# TURSO_DATABASE_URL="libsql://your-db-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-auth-token"
